# Exotel call masking (services/exotelService.js, routes/callRoutes.js)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=

# MSG91 tracking-link SMS (utils/fareCalculator.js sendTrackingSms).
# MSG91's OWN template id for the approved tracking message -- not the
# 19-digit DLT id, which is entered into that template on the MSG91 panel.
# The template must define ##TRACKING_URL##, and savelife.health has to be
# whitelisted on the DLT portal or the message is rejected on content.
# Unset = tracking SMS is skipped (WhatsApp still goes out).
MSG91_TRACKING_TEMPLATE_ID=

# Already required by the OTP flow; sendTrackingSms reuses both.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# Website booking + driver/owner login OTP (template SaveLife_OTP).
MSG91_TEMPLATE_ID=
# Customer app login OTP (template SaveLife_App_OTP). Separate because the two
# templates have different approved bodies and DLT matches on content — the
# wrong one is rejected at the operator rather than by MSG91. Unset means
# POST /api/app/auth/send-otp answers 503 instead of sending nothing.
MSG91_APP_TEMPLATE_ID=

# SEO automation engine (services/seoGenerator.js). Without the key the
# generate endpoint answers 503 with a clear message rather than failing
# oddly -- reading and reviewing existing drafts still works.
ANTHROPIC_API_KEY=
SEO_CLAUDE_MODEL=claude-opus-5
SEO_CLAUDE_EFFORT=high
SEO_SIMILARITY_THRESHOLD=0.55
SEO_MIN_WORDS=700
