# Exotel call masking (services/exotelService.js, routes/callRoutes.js)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=

# MSG91 tracking-link SMS (utils/fareCalculator.js sendTrackingSms).
# MSG91's OWN template id for the approved tracking message -- not the
# 19-digit DLT id, which is entered into that template on the MSG91 panel.
# The template must define ##TRACKING_URL##, and savelife.health has to be
# whitelisted on the DLT portal or the message is rejected on content.
# Unset = tracking SMS is skipped (WhatsApp still goes out).
MSG91_TRACKING_TEMPLATE_ID=

# Already required by the OTP flow; sendTrackingSms reuses both.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# Website booking + driver/owner login OTP (template SaveLife_OTP).
MSG91_TEMPLATE_ID=
# Customer app login OTP (template SaveLife_App_OTP). Separate because the two
# templates have different approved bodies and DLT matches on content — the
# wrong one is rejected at the operator rather than by MSG91. Unset means
# POST /api/app/auth/send-otp answers 503 instead of sending nothing.
MSG91_APP_TEMPLATE_ID=

# SEO automation engine (services/seoGenerator.js). Without the key the
# generate endpoint answers 503 with a clear message rather than failing
# oddly -- reading and reviewing existing drafts still works.
ANTHROPIC_API_KEY=
SEO_CLAUDE_MODEL=claude-opus-5
SEO_CLAUDE_EFFORT=high
SEO_SIMILARITY_THRESHOLD=0.55
SEO_MIN_WORDS=700

# CRM background "New booking" Web Push (services/bookingPush.js). Generate
# once with: npx web-push generate-vapid-keys. Keep the private key ONLY in
# the server env, never in the repo. SUBJECT is a contact URI (mailto: or
# https:). Any of the three unset = push off; the foreground ring still works.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@savelife.health

# ── AI telecaller PILOT (services/aiCaller) ─────────────────────────────
# Master kill-switch: nothing dials unless this is exactly "true". The CRM
# toggle can only switch it off further.
AI_CALLER_ENABLED=false
# The ONLY numbers the pilot may ever call (comma-separated Indian mobiles).
# Each must also have contacted SaveLife first (call, WhatsApp or booking).
AI_CALL_TEST_NUMBERS=
# Optional (defaults shown). Max AI part of a call, 60-600 s.
AI_CALL_MAX_SECONDS=300
# OpenAI GPT-Live: the voice model, and the Responses model it delegates
# tool work (quotes, bookings) to. OpenAI's docs show e.g. gpt-5.6-luna.
AI_REALTIME_MODEL=gpt-live-1
AI_DELEGATE_MODEL=gpt-6-luna
AI_REALTIME_VOICE=marin
# Optional override of the GPT-Live websocket endpoint.
AI_LIVE_WS_URL=wss://api.openai.com/v1/live/sessions
# Optional: signs the Plivo stream URL (falls back to JWT_SECRET).
AI_STREAM_SECRET=
# Optional rough-cost rates (all or none) — from the current OpenAI and
# Plivo price pages; never hardcoded. USD per 1M tokens; Plivo in paise/min.
AI_COST_AUDIO_IN_USD_PER_1M=
AI_COST_AUDIO_OUT_USD_PER_1M=
AI_COST_TEXT_IN_USD_PER_1M=
AI_COST_TEXT_OUT_USD_PER_1M=
AI_COST_CACHED_IN_USD_PER_1M=
AI_COST_USD_TO_INR=
AI_COST_PLIVO_PAISE_PER_MIN=

# ── Live call capture (services/callCapture) ────────────────
# Listen-only: when an operator answers a customer call, Plivo streams it
# to the backend, it is transcribed, and the CRM booking form fills live.
# Nothing is booked or dispatched automatically. Off unless "true".
CALL_CAPTURE_ENABLED=false
# Realtime transcription model (allow it in the OpenAI project).
AI_TRANSCRIBE_MODEL=gpt-live-transcribe
# Optional ISO language hints, e.g. kn,en,hi (blank = auto)
AI_TRANSCRIBE_LANGUAGES=
# Optional; default wss://api.openai.com/v1/realtime?intent=transcription
AI_TRANSCRIBE_WS_URL=
# Booking-detail extraction model (default gpt-6-astra)
AI_EXTRACT_MODEL=gpt-6-astra

# ── AI telecaller: style examples ───────────────────────────
# How many real SaveLife calls (AI Telecaller page -> Style examples) go
# into the assistant's instructions. 0-10, default 3.
AI_STYLE_EXAMPLES_MAX=3

# ── WhatsApp "share your pickup location" (services/locationRequests) ──
# On every incoming customer call, and when the AI telecaller asks for it,
# WhatsApp the caller asking for a location pin; the pin fills the call's
# capture draft / AI call pickup. Off unless "true".
WA_CALL_LOCATION_ENABLED=false
# Approved template sent when the caller has not messaged us in 24 h
# (inside the window the one-tap "Send location" button is sent instead).
WA_LOCATION_TEMPLATE=
WA_LOCATION_TEMPLATE_LANG=kn
